@using Jaffar_Mall_Rent_Management_System.Models
@using Jaffar_Mall_Rent_Management_System.Models.ViewModels
@model PaginatedViewModel<Property>
@{
    ViewData["Title"] = "Properties List";
}

<!-- Top Header & Actions -->
<header class="w-full bg-white dark:bg-[#111418] border-b border-[#dce0e5] dark:border-[#293038] px-8 py-6 shrink-0 z-10">
    <div class="flex flex-col gap-6 max-w-[1400px] mx-auto">
        <!-- Title and Subtitle -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div class="flex flex-col gap-1">
                <h1 class="text-[#111418] dark:text-white text-3xl font-black leading-tight tracking-[-0.033em]">All Properties</h1>
                <p class="text-[#637588] dark:text-[#9dabb8] text-base font-normal">Manage your listings, track occupancy, and monitor rent status.</p>
            </div>
            <!-- Add Property Button & Visualize -->
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Visualize", "Property")" class="flex items-center justify-center rounded-lg h-10 px-4 bg-white dark:bg-[#293038] border border-[#dce0e5] dark:border-[#3e4854] text-[#111418] dark:text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-[#f0f2f4] dark:hover:bg-[#3e4854] transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-[20px] mr-2">view_comfy</span>
                    <span class="truncate">Visualize</span>
                </a>
                <a href="@Url.Action("AddProperty", "Property")" class="flex items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-blue-600 transition-colors shadow-lg shadow-blue-500/20">
                    <span class="material-symbols-outlined text-[20px] mr-2">add</span>
                    <span class="truncate">New Property</span>
                </a>
            </div>
        </div>
        <!-- Search and Filters Bar -->
        <div class="flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center">
        <!-- Search -->
        <form method="get" class="relative w-full lg:max-w-[480px]">
            <div class="flex w-full items-center rounded-lg h-12 bg-[#f0f2f4] dark:bg-[#293038] focus-within:ring-2 focus-within:ring-primary/50 transition-shadow">
                <button type="submit" class="flex items-center justify-center pl-4 pr-2 outline-none">
                    <span class="material-symbols-outlined text-[#637588] dark:text-[#9dabb8]">search</span>
                </button>
                <input name="search" value="@(ViewBag.CurrentSearch ?? "")" class="w-full bg-transparent border-none text-[#111418] dark:text-white placeholder:text-[#637588] dark:placeholder:text-[#9dabb8] focus:ring-0 text-base h-full" placeholder="Search properties by address, name..." />
            </div>
        </form>
            <!-- Filter Chips -->
            <div class="flex flex-wrap gap-2">
                <div class="relative">
                    <select id="filterPayment" class="appearance-none flex h-9 items-center justify-center gap-x-2 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] px-4 pr-10 hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors border border-transparent dark:border-[#3e4854] text-[#111418] dark:text-white text-sm font-medium outline-none">
                        <option value="">Payment: All</option>
                        <option value="Paid" selected="@(ViewBag.CurrentPayment == "Paid" ? "selected" : null)">Payment: Paid</option>
                        <option value="Pending" selected="@(ViewBag.CurrentPayment == "Pending" ? "selected" : null)">Payment: Pending</option>
                        <option value="Overdue" selected="@(ViewBag.CurrentPayment == "Overdue" ? "selected" : null)">Payment: Overdue</option>
                    </select>
                    <span class="material-symbols-outlined text-[#111418] dark:text-white text-[20px] pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">keyboard_arrow_down</span>
                </div>

                <div class="relative">
                    <select id="filterStatus" class="appearance-none flex h-9 items-center justify-center gap-x-2 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] px-4 pr-10 hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors border border-transparent dark:border-[#3e4854] text-[#111418] dark:text-white text-sm font-medium outline-none">
                        <option value="">Status: All</option>
                        <option value="1" selected="@(ViewBag.CurrentStatus == 1 ? "selected" : null)">Status: Vacant</option>
                        <option value="2" selected="@(ViewBag.CurrentStatus == 2 ? "selected" : null)">Status: Occupied</option>
                    </select>
                    <span class="material-symbols-outlined text-[#111418] dark:text-white text-[20px] pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">keyboard_arrow_down</span>
                </div>
                
                <div class="relative">
                    <select id="filterType" class="appearance-none flex h-9 items-center justify-center gap-x-2 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] px-4 pr-10 hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors border border-transparent dark:border-[#3e4854] text-[#111418] dark:text-white text-sm font-medium outline-none">
                        <option value="">Type: All</option>
                        <option value="Apartment" selected="@(ViewBag.CurrentType == "Apartment" ? "selected" : null)">Type: Apartment</option>
                        <option value="Single Family House" selected="@(ViewBag.CurrentType == "Single Family House" ? "selected" : null)">Type: Single Family House</option>
                        <option value="Condo" selected="@(ViewBag.CurrentType == "Condo" ? "selected" : null)">Type: Condo</option>
                        <option value="Townhouse" selected="@(ViewBag.CurrentType == "Townhouse" ? "selected" : null)">Type: Townhouse</option>
                        <option value="Commercial" selected="@(ViewBag.CurrentType == "Commercial" ? "selected" : null)">Type: Commercial</option>
                        <option value="Industrial" selected="@(ViewBag.CurrentType == "Industrial" ? "selected" : null)">Type: Industrial</option>
                    </select>
                    <span class="material-symbols-outlined text-[#111418] dark:text-white text-[20px] pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">keyboard_arrow_down</span>
                </div>

                <div class="relative">
                    <select id="filterSort" class="appearance-none flex h-9 items-center justify-center gap-x-2 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] px-4 pr-10 hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors border border-transparent dark:border-[#3e4854] text-[#111418] dark:text-white text-sm font-medium outline-none">
                        <option value="">Sort by: Default</option>
                        <option value="date_desc" selected="@(ViewBag.CurrentSort == "date_desc" ? "selected" : null)">Sort by: Newest</option>
                        <option value="date_asc" selected="@(ViewBag.CurrentSort == "date_asc" ? "selected" : null)">Sort by: Oldest</option>
                        <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc" ? "selected" : null)">Sort by: Name (A-Z)</option>
                        <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc" ? "selected" : null)">Sort by: Name (Z-A)</option>
                    </select>
                    <span class="material-symbols-outlined text-[#111418] dark:text-white text-[20px] pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">sort</span>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Scrollable List Area -->
<div class="flex-1 overflow-y-auto p-4 sm:p-8">
    <div id="property-list-container">
        <partial name="_PropertyListPartial" model="Model" />
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        let debounceTimer;
        const searchInput = document.querySelector('input[name="search"]');
        const listContainer = document.getElementById('property-list-container');
        const form = searchInput.closest('form');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            performSearch();
        });

        searchInput.addEventListener('input', function (e) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                performSearch();
            }, 300);
        });

        function performSearch() {
            const url = new URL(window.location.origin + '@Url.Action("Index", "Property")');
            
            const query = searchInput.value;
            if (query) url.searchParams.set('search', query);
            
            const type = document.getElementById('filterType').value;
            if (type) url.searchParams.set('type', type);

            const status = document.getElementById('filterStatus').value;
            if (status) url.searchParams.set('status', status);

            const payment = document.getElementById('filterPayment').value;
            if (payment) url.searchParams.set('payment', payment);

            const sort = document.getElementById('filterSort').value;
            if (sort) url.searchParams.set('sort', sort);

            url.searchParams.set('page', 1);
            window.history.pushState({}, '', url);

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.text();
            })
            .then(html => {
                listContainer.innerHTML = html;
                currentOpenDropdown = null;
            })
            .catch(error => console.error('Error fetching properties:', error));
        }

        // Add event listeners for filters
        document.getElementById('filterType').addEventListener('change', performSearch);
        document.getElementById('filterStatus').addEventListener('change', performSearch);
        document.getElementById('filterPayment').addEventListener('change', performSearch);
        document.getElementById('filterSort').addEventListener('change', performSearch);

        let currentOpenDropdown = null;
        window.toggleDropdown = function(event, id) {
            event.stopPropagation();
            const dropdown = document.getElementById('dropdown-' + id);
            if (currentOpenDropdown && currentOpenDropdown !== dropdown) {
                currentOpenDropdown.classList.add('hidden');
            }
            if (dropdown.classList.contains('hidden')) {
                dropdown.classList.remove('hidden');
                currentOpenDropdown = dropdown;
            } else {
                dropdown.classList.add('hidden');
                currentOpenDropdown = null;
            }
        };

        document.addEventListener('click', function(event) {
            if (currentOpenDropdown) {
                currentOpenDropdown.classList.add('hidden');
                currentOpenDropdown = null;
            }
        });

        window.deleteProperty = async function(id) {
             try {
                 const response = await fetch('/Property/DeleteProperty?id=' + id, { 
                     method: 'DELETE',
                     headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                     }
                 });
                 const result = await response.json();
                 if (response.ok && result.code === 200) { 
                     performSearch(); 
                 } else {
                     alert('Failed to delete property: ' + (result.message || 'Unknown error'));
                 }
             } catch (error) {
                 console.error('Error:', error);
                 alert('An error occurred while deleting the property.');
             }
        };
    });
</script>
}