@model IEnumerable<Jaffar_Mall_Rent_Management_System.Models.ViewModels.VoucherListItemViewModel>
@{
    ViewData["Title"] = "All Vouchers";
}

<header class="h-16 flex items-center justify-between px-6 border-b border-[#293038] bg-background-dark shrink-0 z-20">
    <div class="flex items-center gap-4">
        <h2 class="text-lg font-bold text-white">All Vouchers</h2>
    </div>
</header>

<div class="flex-1 overflow-y-auto p-6 scroll-smooth">
    <div class="max-w-7xl mx-auto space-y-6 pb-10">
        
        <div class="bg-[#1e252b] rounded-xl border border-[#293038] overflow-hidden">
            <div class="p-6 border-b border-[#293038] flex items-center justify-between">
                <div>
                    <h3 class="text-white text-base font-bold">Voucher History</h3>
                    <p class="text-xs text-[#9dabb8] mt-1">Records of all rent payments and maintenance vouchers.</p>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#293038]/50 text-[#9dabb8] text-xs uppercase tracking-wider">
                            <th class="px-6 py-3 font-semibold">Date</th>
                            <th class="px-6 py-3 font-semibold">Type</th>
                            <th class="px-6 py-3 font-semibold">Title</th>
                            <th class="px-6 py-3 font-semibold text-right">Amount</th>
                            <th class="px-6 py-3 font-semibold text-center">Status</th>
                            <th class="px-6 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#293038]">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="hover:bg-[#293038]/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <p class="text-white text-sm font-medium">@item.Date.ToString("MMM dd, yyyy")</p>
                                        <p class="text-[#9dabb8] text-xs">@item.Date.ToString("hh:mm tt")</p>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if(item.Type == "Rent")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                                <span class="material-symbols-outlined text-[14px]">payments</span> @item.Type
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                                <span class="material-symbols-outlined text-[14px]">plumbing</span> @item.Type
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-white text-sm font-bold">@item.Title</p>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-emerald-400 text-sm font-bold">@item.Amount.ToString("C")</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (item.Status == "Paid" || item.Status == "Resolved")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/10 text-green-500">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-500/10 text-orange-500">@item.Status</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <a href="@item.LinkUrl" target="_blank" class="inline-flex items-center gap-1 bg-primary/20 hover:bg-primary/30 text-primary transition-colors text-xs font-bold py-1.5 px-3 rounded-lg">
                                            <span class="material-symbols-outlined text-[16px]">print</span>
                                            View Voucher
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-[#9dabb8]">No vouchers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
