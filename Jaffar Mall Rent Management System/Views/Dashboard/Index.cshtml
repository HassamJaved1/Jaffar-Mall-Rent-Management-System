@using Jaffar_Mall_Rent_Management_System.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";
}

<!-- Top Header -->
<header class="h-16 flex items-center justify-between px-6 border-b border-[#293038] bg-background-dark shrink-0 z-20">
    <div class="flex items-center gap-4">
        <!-- Mobile Menu Button (Visible only on small screens) -->
        <button class="md:hidden text-white p-2">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <h2 class="text-lg font-bold text-white hidden sm:block">Dashboard Overview</h2>
    </div>
    <div class="flex items-center gap-4 flex-1 justify-end">
        <form asp-controller="Property" asp-action="Index" method="get" class="hidden sm:flex items-center max-w-md flex-1 mx-4">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#9dabb8]">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                </div>
                <input name="search" class="block w-full rounded-lg border-0 py-2 pl-10 bg-[#1e252b] text-white placeholder-[#9dabb8] focus:ring-2 focus:ring-primary focus:bg-[#293038] sm:text-sm sm:leading-6 transition-all" placeholder="Search properties, tenants..." type="text" />
            </div>
        </form>
        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button class="relative p-2 rounded-lg text-[#9dabb8] hover:text-white hover:bg-[#293038] transition-colors">
                <span class="material-symbols-outlined">notifications</span>
                <span class="absolute top-2 right-2 size-2 bg-red-500 rounded-full border border-background-dark"></span>
            </button>
            <button class="p-2 rounded-lg text-[#9dabb8] hover:text-white hover:bg-[#293038] transition-colors">
                <span class="material-symbols-outlined">help</span>
            </button>
       
            <a asp-controller="Leases" asp-action="Index" class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white text-sm font-semibold py-2 px-4 rounded-lg transition-colors shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span class="hidden sm:inline">Assign Property</span>
            </a>
          
        </div>
    </div>
</header>
<!-- Scrollable Content Area -->
<div class="flex-1 overflow-y-auto p-6 scroll-smooth">
    <div class="max-w-7xl mx-auto space-y-6 pb-10">
        <!-- Welcome Section -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-white tracking-tight">Good Morning, @Model.ManagerName 👋</h2>
                <p class="text-[#9dabb8] mt-1">Here's what's happening with your properties today.</p>
            </div>
            <div class="flex items-center gap-2 bg-[#1e252b] rounded-lg p-1 border border-[#293038]">
                <button class="px-3 py-1.5 text-sm font-medium rounded text-white bg-[#293038] shadow-sm">Last 30 Days</button>
                <button class="px-3 py-1.5 text-sm font-medium rounded text-[#9dabb8] hover:text-white hover:bg-[#293038]/50">Last Quarter</button>
                <button class="px-3 py-1.5 text-sm font-medium rounded text-[#9dabb8] hover:text-white hover:bg-[#293038]/50">Last Year</button>
            </div>
        </div>
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Revenue -->
            <div class="bg-[#1e252b] p-5 rounded-xl border border-[#293038] hover:border-primary/30 transition-colors group">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 rounded-lg bg-green-500/10 text-green-500">
                        <span class="material-symbols-outlined">attach_money</span>
                    </div>
                </div>
                <p class="text-[#9dabb8] text-sm font-medium">Total Revenue</p>
                <h3 class="text-2xl font-bold text-white mt-1">PKR @Model.TotalRevenue.ToString("N0")</h3>
            </div>
            <!-- Occupancy -->
            <div class="bg-[#1e252b] p-5 rounded-xl border border-[#293038] hover:border-primary/30 transition-colors group">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 rounded-lg bg-blue-500/10 text-blue-500">
                        <span class="material-symbols-outlined">apartment</span>
                    </div>
                </div>
                <p class="text-[#9dabb8] text-sm font-medium">Occupancy Rate</p>
                <h3 class="text-2xl font-bold text-white mt-1">@Model.OccupancyRate.ToString("F1")%</h3>
            </div>
            <!-- Pending Payments -->
            <div class="bg-[#1e252b] p-5 rounded-xl border border-[#293038] hover:border-primary/30 transition-colors group">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 rounded-lg bg-orange-500/10 text-orange-500">
                        <span class="material-symbols-outlined">pending_actions</span>
                    </div>
                </div>
                <p class="text-[#9dabb8] text-sm font-medium">Pending Payments</p>
                <h3 class="text-2xl font-bold text-white mt-1">PKR @((Model.PendingRentAmount + Model.PendingSecurityAmount).ToString("N0"))</h3>
                <div class="flex gap-2 mt-2">
                    <span class="text-[10px] text-[#9dabb8]">Rent: @Model.PendingRentAmount.ToString("N0")</span>
                    <span class="text-[10px] text-[#9dabb8]">Security: @Model.PendingSecurityAmount.ToString("N0")</span>
                </div>
            </div>
            <!-- Active Maintenance -->
            <div class="bg-[#1e252b] p-5 rounded-xl border border-[#293038] hover:border-primary/30 transition-colors group">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-2 rounded-lg bg-red-500/10 text-red-500">
                        <span class="material-symbols-outlined">plumbing</span>
                    </div>
                </div>
                <p class="text-[#9dabb8] text-sm font-medium">Active Maintenance</p>
                <h3 class="text-2xl font-bold text-white mt-1">@Model.ActiveMaintenanceCount</h3>
            </div>
        </div>
        <!-- Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Rent Status Chart -->
            <div class="bg-[#1e252b] p-6 rounded-xl border border-[#293038] flex flex-col">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-white text-base font-bold">Rent Status</h3>
                    <button class="text-[#9dabb8] hover:text-white">
                        <span class="material-symbols-outlined">more_horiz</span>
                    </button>
                </div>
                <div class="flex-1 flex flex-col gap-4">
                    @foreach (var item in Model.RentStatus ?? new List<RentStatusItem>())
                    {
                        <div class="relative pt-2">
                            <div class="flex justify-between items-end mb-1">
                                <span class="text-sm font-medium text-[#9dabb8]">@item.Label</span>
                                <span class="text-sm font-bold text-white">PKR @item.Amount.ToString("N0") (@item.Percentage.ToString("F0")%)</span>
                            </div>
                            <div class="w-full bg-[#293038] rounded-full h-2.5">
                                <div class="@item.Color h-2.5 rounded-full" style="width: @item.Percentage%"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-6 pt-6 border-t border-[#293038] flex justify-between items-center text-sm">
                    <span class="text-[#9dabb8]">Total Expected</span>
                    <span class="font-bold text-white">PKR 48,600</span>
                </div>
            </div>
            <!-- Cash Flow Graph -->
            <div class="bg-[#1e252b] p-6 rounded-xl border border-[#293038] lg:col-span-2 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-white text-base font-bold">Cash Flow Overview</h3>
                        <p class="text-xs text-[#9dabb8]">Last 6 months revenue vs expenses</p>
                    </div>
                    <div class="flex gap-2">
                        <div class="flex items-center gap-1.5 px-2 py-1 rounded bg-[#293038]/50">
                            <span class="size-2 rounded-full bg-primary"></span>
                            <span class="text-xs text-white">Income</span>
                        </div>
                        <div class="flex items-center gap-1.5 px-2 py-1 rounded bg-[#293038]/50">
                            <span class="size-2 rounded-full bg-[#9dabb8]"></span>
                            <span class="text-xs text-white">Expense</span>
                        </div>
                    </div>
                </div>
                <div class="flex-1 min-h-[200px] w-full relative flex items-end justify-between gap-2 pt-8 pb-2 px-2">
                    @foreach (var item in Model.MonthlyCashFlow ?? new List<MonthlyCashFlowItem>())
                    {
                        <div class="flex flex-col gap-1 w-full items-center group cursor-pointer">
                            <div class="w-full max-w-[40px] flex gap-1 h-[140px] items-end">
                                <div class="w-1/2 bg-primary/80 group-hover:bg-primary rounded-t-sm transition-all relative" style="height: @item.IncomePercentage%"></div>
                                <div class="w-1/2 bg-[#9dabb8]/50 group-hover:bg-[#9dabb8]/80 rounded-t-sm transition-all" style="height: @item.ExpensePercentage%"></div>
                            </div>
                            <span class="text-xs text-[#9dabb8] font-medium">@item.Month</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Main Grid: Property List & Recent Activity -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <!-- Properties Table -->
            <div class="xl:col-span-2 bg-[#1e252b] rounded-xl border border-[#293038] overflow-hidden">
                <div class="p-6 border-b border-[#293038] flex items-center justify-between">
                    <h3 class="text-white text-base font-bold">Top Properties</h3>
                    <a class="text-sm text-primary hover:text-primary/80 font-medium" href="@Url.Action("Index", "Property")">View All</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-[#293038]/50 text-[#9dabb8] text-xs uppercase tracking-wider">
                                <th class="px-6 py-3 font-semibold">Property</th>
                                <th class="px-6 py-3 font-semibold">Status</th>
                                <th class="px-6 py-3 font-semibold">Tenant</th>
                                <th class="px-6 py-3 font-semibold text-right">Rent</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#293038]">
                        @if (!(Model.TopProperties?.Any() ?? false)) {
                                <tr>
                                    <td colspan="4" class="px-6 py-10 text-center text-[#9dabb8]">No active assignments found.</td>
                                </tr>
                            }
                            @foreach (var p in Model.TopProperties ?? new List<LeaseListItemViewModel>())
                            {
                                <tr class="hover:bg-[#293038]/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="size-10 rounded-lg bg-gray-700 flex items-center justify-center text-white font-bold">
                                                <span class="material-symbols-outlined">apartment</span>
                                            </div>
                                            <div>
                                                <p class="text-white text-sm font-medium">@p.PropertyName</p>
                                                <p class="text-[#9dabb8] text-xs">Unit @p.PropertyNumber</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/10 text-green-500">
                                            Occupied
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div class="size-6 rounded-full bg-[#293038] flex items-center justify-center text-xs text-white">@(p.TenantName != null ? p.TenantName.Substring(0, Math.Min(2, p.TenantName.Length)).ToUpper() : "??")</div>
                                            <span class="text-white text-sm">@(p.TenantName ?? "N/A")</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm font-medium">PKR @(p.Lease?.RentAmount.ToString("N0") ?? "0")</span>
                                        <span class="block text-[#9dabb8] text-xs">@(p.Lease?.Months ?? 0) Months</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Recent Activity & Notifications -->
            <div class="flex flex-col gap-6">
                <!-- Maintenance Alerts -->
                <div class="bg-[#1e252b] rounded-xl border border-[#293038] p-6">
                    <h3 class="text-white text-base font-bold mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-red-500">warning</span>
                        Attention Required
                    </h3>
                    <div class="space-y-4">
                        @if (!(Model.Alerts?.Any() ?? false)) {
                            <p class="text-[#9dabb8] text-xs">No pending items requiring attention.</p>
                        }
                        @foreach (var alert in Model.Alerts ?? new List<DashboardAlert>())
                        {
                            <div class="flex gap-3 items-start pb-4 border-b border-[#293038] last:border-0 last:pb-0">
                                <div class="size-8 rounded bg-@alert.Color-500/10 text-@alert.Color-500 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-sm">@alert.Icon</span>
                                </div>
                                <div>
                                    <p class="text-white text-sm font-medium">@alert.Title</p>
                                    <p class="text-[#9dabb8] text-xs mt-1">@alert.Description</p>
                                    <div class="mt-2 flex gap-2">
                                        @if (alert.ActionType == "ViewTicket") {
                                            <a href="@Url.Action("Index", "Maintenance")" class="text-xs bg-[#293038] hover:bg-[#363f4a] text-white px-2 py-1 rounded transition-colors">View Ticket</a>
                                        } else {
                                            <button class="text-xs bg-primary/20 hover:bg-primary/30 text-primary px-2 py-1 rounded transition-colors">Send Reminder</button>
                                        }
                                        <span class="text-[10px] text-[#9dabb8] self-center ml-auto">@alert.TimeAgo</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Recent Communications -->
                <div class="bg-[#1e252b] rounded-xl border border-[#293038] p-6 flex-1">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-white text-base font-bold">Recent Messages</h3>
                        <span class="material-symbols-outlined text-[#9dabb8] text-sm cursor-pointer">mail</span>
                    </div>
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <div class="size-8 rounded-full bg-cover bg-center shrink-0" data-alt="Female tenant portrait" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD-6zF9Jt6J0-sXFA16KAD1H-q92RLM2YxkKJZT9mYMnmpS_bfeWCbtFCXqgjls2H4-X5YA7BoCpYeFfTsTBktfxUFMt4P4m7wzQeTTX5N1ayuzOJmrCkZ4FKvVWcz7pjJk6VdgE13cCfyypm1sKGms-bds5woRMxsCfi48jDw_gOOWplyDwH_gwRChm9foA2qSC_fvPxXX6ZiQU-dI79Cd8DG5XZiS1C4dxWfXmnlR1AYNSedFTWit97QNZzRN16sEbXJtYgk-DDlG');"></div>
                            <div>
                                <div class="flex justify-between w-full">
                                    <p class="text-sm font-medium text-white">Sarah Connor</p>
                                    <span class="text-[10px] text-[#9dabb8]">10m ago</span>
                                </div>
                                <p class="text-xs text-[#9dabb8] mt-0.5 line-clamp-2">Hi Hassam, just wanted to check if the parking spot is available for next month?</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="size-8 rounded-full bg-cover bg-center shrink-0" data-alt="Male tenant portrait" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD8_iGKsI3ofZ9SLsOs8FZSmBTXqyOeqypNwNTHEJ09BuvC5AjPDep9obUlDyVQSJ_jh0CaHaGOrH5s-8BPpo3dMrC4Tdzcbsk2lvvz2JAWsecuoDIaIBRWfeLmFTxXlm5Ek4ThO8Y5gru-i4koAJb4ICxCO967rR3S5OgNn0a_4QncOjR0Hs7E5prUgcWcXKRB-G_1vX-3_YUnX-kvsrEElEYUnUTn9NWGjQnRR88cOLhdeE5AyK6l4xm3bT9i8ivAR49yTrlsZC4t');"></div>
                            <div>
                                <div class="flex justify-between w-full">
                                    <p class="text-sm font-medium text-white">David Miller</p>
                                    <span class="text-[10px] text-[#9dabb8]">2h ago</span>
                                </div>
                                <p class="text-xs text-[#9dabb8] mt-0.5 line-clamp-2">Thanks for fixing the heater so quickly! Much appreciated.</p>
                            </div>
                        </div>
                    </div>
                    <button class="w-full mt-4 py-2 text-sm text-[#9dabb8] hover:text-white border border-[#293038] hover:bg-[#293038] rounded-lg transition-colors">
                        View All Messages
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>