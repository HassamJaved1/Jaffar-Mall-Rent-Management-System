@using Jaffar_Mall_Rent_Management_System.Models
@{
    ViewData["Title"] = "Upload Document";
    var tenants = ViewBag.Tenants?.Data as IEnumerable<Tenant>;
}

<!-- Top Header -->
<header class="w-full bg-white dark:bg-[#111418] border-b border-[#dce0e5] dark:border-[#293038] px-8 py-6 shrink-0 z-10">
    <div class="flex flex-col gap-6 max-w-[800px] mx-auto">
        <div class="flex items-center gap-4">
            <a href="@Url.Action("Index", "Document")" class="flex items-center justify-center w-10 h-10 rounded-full bg-[#f0f2f4] dark:bg-[#293038] text-[#111418] dark:text-white hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <h1 class="text-[#111418] dark:text-white text-3xl font-black leading-tight tracking-[-0.033em]">Upload Document</h1>
        </div>
    </div>
</header>

<div class="flex-1 overflow-y-auto p-4 sm:p-8">
    <div class="max-w-[800px] mx-auto">
        <div class="bg-white dark:bg-[#1a1d23] rounded-xl border border-[#dce0e5] dark:border-[#293038] shadow-sm p-6 sm:p-8">
            <form asp-action="Add" asp-controller="Document" method="post" enctype="multipart/form-data" class="flex flex-col gap-6">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-500/10 border border-red-500/20 text-red-500 rounded-lg p-4 mb-4">
                        <div asp-validation-summary="All" class="text-sm font-medium"></div>
                    </div>
                }

                <div class="flex flex-col gap-2">
                    <label class="text-[#111418] dark:text-white text-base font-bold leading-normal">Document Description</label>
                    <input type="text" name="description" required placeholder="e.g. Jan 2026 Rent Receipt" class="w-full h-14 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] border-none text-[#111418] dark:text-white px-4 focus:ring-2 focus:ring-primary/50 transition-shadow outline-none placeholder:text-[#637588] dark:placeholder:text-[#9dabb8]" />
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[#111418] dark:text-white text-base font-bold leading-normal">Select Tenant</label>
                    <div class="relative">
                        <select name="tenantId" required class="w-full h-14 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] border-none text-[#111418] dark:text-white px-4 pr-10 appearance-none focus:ring-2 focus:ring-primary/50 transition-shadow outline-none">
                            <option value="">-- Choose Tenant --</option>
                            @if (tenants != null)
                            {
                                @foreach (var t in tenants)
                                {
                                    <option value="@t.Id">@t.Name (@t.Phone_No)</option>
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined text-[#637588] dark:text-[#9dabb8] absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[#111418] dark:text-white text-base font-bold leading-normal">Upload File (Image/PDF)</label>
                    <div class="relative border-2 border-dashed border-[#dce0e5] dark:border-[#3e4854] rounded-xl hover:border-primary/50 transition-colors">
                        <input type="file" name="file" accept="image/*,.pdf" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" id="fileInput" onchange="updateFileName(this)" />
                        <div class="flex flex-col items-center justify-center py-12 pointer-events-none">
                            <span class="material-symbols-outlined text-4xl text-[#9dabb8] mb-3" id="uploadIcon">cloud_upload</span>
                            <p class="text-sm font-semibold text-[#111418] dark:text-white" id="fileNameDisplay">Click or drag file to upload</p>
                            <p class="text-xs text-[#637588] dark:text-[#9dabb8] mt-1">Supports JPG, PNG, PDF</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-[#dce0e5] dark:border-[#293038]">
                    <a href="@Url.Action("Index", "Document")" class="h-10 px-6 rounded-lg bg-[#f0f2f4] dark:bg-[#293038] text-[#111418] dark:text-white text-sm font-bold flex items-center justify-center hover:bg-[#e1e4e8] dark:hover:bg-[#3e4854] transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="h-10 px-6 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center hover:bg-blue-600 transition-colors shadow-lg shadow-blue-500/20">
                        Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateFileName(input) {
            const fileNameDisplay = document.getElementById('fileNameDisplay');
            const uploadIcon = document.getElementById('uploadIcon');
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                fileNameDisplay.textContent = file.name;
                uploadIcon.textContent = 'check_circle';
                uploadIcon.classList.remove('text-[#9dabb8]');
                uploadIcon.classList.add('text-emerald-500');
            } else {
                fileNameDisplay.textContent = 'Click or drag file to upload';
                uploadIcon.textContent = 'cloud_upload';
                uploadIcon.classList.remove('text-emerald-500');
                uploadIcon.classList.add('text-[#9dabb8]');
            }
        }
    </script>
}
