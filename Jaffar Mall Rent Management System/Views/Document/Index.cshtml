@using Jaffar_Mall_Rent_Management_System.Models
@model IEnumerable<Document>

@{
    ViewData["Title"] = "Documents & Receipts";
}

<header class="w-full bg-white dark:bg-[#111418] border-b border-[#dce0e5] dark:border-[#293038] px-8 py-6 shrink-0 z-10">
    <div class="flex flex-col gap-6 max-w-[1400px] mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div class="flex flex-col gap-1">
                <h1 class="text-[#111418] dark:text-white text-3xl font-black leading-tight tracking-[-0.033em]">Documents & Receipts</h1>
                <p class="text-[#637588] dark:text-[#9dabb8] text-base font-normal">Manage your uploaded rent receipts and tenant documents securely.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Add", "Document")" class="flex items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-blue-600 transition-colors shadow-lg shadow-blue-500/20">
                    <span class="material-symbols-outlined text-[20px] mr-2">upload_file</span>
                    <span class="truncate">Upload Document</span>
                </a>
            </div>
        </div>
    </div>
</header>

<div class="flex-1 overflow-y-auto p-4 sm:p-8">
    <div class="max-w-[1400px] mx-auto flex flex-col gap-4">
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var doc in Model)
                {
                    <div class="group flex flex-col rounded-xl bg-white dark:bg-[#1a1d23] border border-[#dce0e5] dark:border-[#293038] shadow-sm hover:shadow-md transition-all overflow-hidden relative">
                        <div class="w-full h-48 bg-[#f0f2f4] dark:bg-[#20242b] flex items-center justify-center overflow-hidden">
                            @if (doc.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="material-symbols-outlined text-6xl text-red-500">picture_as_pdf</span>
                            }
                            else
                            {
                                <img src="@doc.FilePath" alt="Document" class="w-full h-full object-cover transition-transform group-hover:scale-105" />
                            }
                        </div>
                        <div class="p-4 flex flex-col flex-1">
                            <h3 class="text-base font-bold text-[#111418] dark:text-white mb-1 truncate" title="@doc.Description">@doc.Description</h3>
                            <div class="flex items-center gap-2 mt-auto text-sm text-[#637588] dark:text-[#9dabb8]">
                                <span class="material-symbols-outlined text-[16px]">person</span>
                                <span class="truncate">@doc.TenantName</span>
                            </div>
                            <div class="flex items-center gap-2 mt-1 text-xs text-[#637588] dark:text-[#9dabb8]">
                                <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                                <span>@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="absolute top-2 right-2 flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                            <a href="@doc.FilePath" target="_blank" class="w-8 h-8 rounded-full bg-white dark:bg-[#293038] flex items-center justify-center text-blue-500 hover:bg-blue-50 dark:hover:bg-[#3e4854] shadow-sm transition-colors" title="View Full">
                                <span class="material-symbols-outlined text-[18px]">visibility</span>
                            </a>
                            <button onclick="if(confirm('Delete document?')) deleteDocument(@doc.Id)" class="w-8 h-8 rounded-full bg-white dark:bg-[#293038] flex items-center justify-center text-red-500 hover:bg-red-50 dark:hover:bg-[#3e4854] shadow-sm transition-colors" title="Delete">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center p-10 text-center bg-white dark:bg-[#1a1d23] rounded-xl border border-[#dce0e5] dark:border-[#293038]">
                <span class="material-symbols-outlined text-6xl text-[#9dabb8] mb-4">folder_open</span>
                <h3 class="text-xl font-bold text-[#111418] dark:text-white">No Documents found</h3>
                <p class="text-[#637588] dark:text-[#9dabb8] mt-2">Upload pictures or receipts of rent payments here.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function deleteDocument(id) {
            fetch(`/Document/Delete/${id}`, {
                method: 'DELETE'
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Failed to delete: ' + data.message);
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}
