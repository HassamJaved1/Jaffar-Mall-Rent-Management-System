@model IEnumerable<Jaffar_Mall_Rent_Management_System.Models.ViewModels.RentStatusViewModel>

@{
    ViewData["Title"] = "Add Rent Payment";
    var rentPayment = new Jaffar_Mall_Rent_Management_System.Models.RentPayment();
}

<!-- Top Header -->
<header class="h-16 flex items-center justify-between px-6 border-b border-[#293038] bg-background-dark shrink-0 z-20">
    <div class="flex items-center gap-4">
        <h2 class="text-lg font-bold text-white">Add Rent Payment</h2>
    </div>
    <div class="flex items-center gap-4 flex-1 justify-end">
        <a asp-action="Index" class="text-[#9dabb8] hover:text-white transition-colors text-sm font-medium">Cancel</a>
    </div>
</header>

<!-- Scrollable Content Area -->
<div class="flex-1 overflow-y-auto p-6 scroll-smooth">
    <div class="max-w-2xl mx-auto space-y-6 pb-10">
        
        <div class="bg-[#1e252b] rounded-xl border border-[#293038] p-6">
            <h3 class="text-white text-base font-bold mb-4">Payment Details</h3>
            
            <!-- Tabs -->
            @* <div class="flex gap-4 border-b border-[#293038] mb-6">
                <button type="button" id="tabRent" class="px-4 py-3 text-sm font-bold border-b-2 border-primary text-white transition-all" onclick="switchTab('Rent')">Rent Payment</button>
                <button type="button" id="tabSecurity" class="px-4 py-3 text-sm font-medium border-b-2 border-transparent text-[#9dabb8] hover:text-white transition-all" onclick="switchTab('Security Fee')">Security Fee</button>
            </div> *@

            
            <form asp-action="Create" method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>

                <div>
                    <label class="block text-sm font-medium text-[#9dabb8] mb-1">Select Lease</label>
                    <select name="LeaseId" id="LeaseIdSelect" class="block w-full rounded-lg border-0 py-2.5 bg-[#293038] text-white focus:ring-2 focus:ring-primary sm:text-sm sm:leading-6 transition-all" required onchange="updateBalanceInfo()">
                        <option value="">-- Select Active Lease --</option>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <option value="@item.LeaseId" data-rent-bal="@item.Balance" data-sec-bal="@item.SecurityBalance">
                                    @item.TenantName - @item.PropertyName (@item.PropertyNumber)
                                </option>
                            }
                        }
                    </select>
                    <div id="balanceInfo" class="mt-2 text-xs font-semibold space-y-1 hidden">
                        <p id="rentBalContainer" class="text-blue-400">Rent Balance Remaining: <span id="rentBalDisplay">PKR 0.00</span></p>
                        <p id="secBalContainer" class="text-yellow-400 hidden">Security Fee Remaining: <span id="secBalDisplay">PKR 0.00</span></p>
                    </div>
                </div>

                <input type="hidden" name="PaymentType" id="PaymentTypeInput" value="Rent" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6" style="display:none;">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-[#9dabb8] mb-1">Relaxation Days (Grace Period)</label>
                        <input type="number" name="RelaxationDays" value="0" min="0" class="block w-full rounded-lg border-0 py-2.5 bg-[#293038] text-white placeholder-[#9dabb8] focus:ring-2 focus:ring-primary sm:text-sm sm:leading-6 transition-all" />
                        <p class="mt-1 text-[10px] text-[#9dabb8]">Days allowed to pay the remaining balance.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-[#9dabb8] mb-1">Amount</label>
                        <div class="relative mt-1 rounded-md shadow-sm">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                <span class="text-[#9dabb8] sm:text-sm">PKR</span>
                            </div>
                            <input type="number" step="0.01" name="Amount" class="block w-full rounded-lg border-0 py-2.5 pl-10 bg-[#293038] text-white placeholder-[#9dabb8] focus:ring-2 focus:ring-primary sm:text-sm sm:leading-6 transition-all" placeholder="0.00" required />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-[#9dabb8] mb-1">Payment Date</label>
                        <input type="datetime-local" name="PaymentDate" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="block w-full rounded-lg border-0 py-2.5 bg-[#293038] text-white placeholder-[#9dabb8] focus:ring-2 focus:ring-primary sm:text-sm sm:leading-6 transition-all" required />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-[#9dabb8] mb-1">Payment Method</label>
                    <div class="grid grid-cols-2 gap-4 mt-2">
                         <label class="cursor-pointer">
                            <input type="radio" name="PaymentMethod" value="Cash" class="peer sr-only" checked />
                            <div class="rounded-lg border border-[#293038] bg-[#293038]/50 p-3 hover:bg-[#293038] peer-checked:border-primary peer-checked:bg-primary/10 transition-all text-center">
                                <p class="text-white text-sm font-medium">Cash</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="PaymentMethod" value="Bank Transfer" class="peer sr-only" />
                            <div class="rounded-lg border border-[#293038] bg-[#293038]/50 p-3 hover:bg-[#293038] peer-checked:border-primary peer-checked:bg-primary/10 transition-all text-center">
                                <p class="text-white text-sm font-medium">Bank Transfer</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="PaymentMethod" value="Mobile Transfer" class="peer sr-only" />
                            <div class="rounded-lg border border-[#293038] bg-[#293038]/50 p-3 hover:bg-[#293038] peer-checked:border-primary peer-checked:bg-primary/10 transition-all text-center">
                                <p class="text-white text-sm font-medium">Mobile Transfer</p>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="PaymentMethod" value="Cheque" class="peer sr-only" />
                            <div class="rounded-lg border border-[#293038] bg-[#293038]/50 p-3 hover:bg-[#293038] peer-checked:border-primary peer-checked:bg-primary/10 transition-all text-center">
                                <p class="text-white text-sm font-medium">Cheque</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-[#9dabb8] mb-1">Remarks (Optional)</label>
                    <textarea name="Remarks" rows="3" class="block w-full rounded-lg border-0 py-2.5 bg-[#293038] text-white placeholder-[#9dabb8] focus:ring-2 focus:ring-primary sm:text-sm sm:leading-6 transition-all"></textarea>
                </div>

                <div class="pt-4 flex gap-4">
                    <button type="submit" class="flex-1 bg-primary hover:bg-primary/90 text-white font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-lg shadow-primary/20">
                        Confirm Payment
                    </button>
                    <a asp-action="Index" class="px-6 py-2.5 rounded-lg border border-[#293038] text-white hover:bg-[#293038] transition-colors font-medium">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let currentTab = 'Rent';

        function switchTab(type) {
            currentTab = type;
            document.getElementById('PaymentTypeInput').value = type;
            
            const tabRent = document.getElementById('tabRent');
            const tabSec = document.getElementById('tabSecurity');
            
            if (type === 'Rent') {
                tabRent.className = "px-4 py-3 text-sm font-bold border-b-2 border-primary text-white transition-all";
                tabSec.className = "px-4 py-3 text-sm font-medium border-b-2 border-transparent text-[#9dabb8] hover:text-white transition-all";
            } else {
                tabSec.className = "px-4 py-3 text-sm font-bold border-b-2 border-yellow-500 text-white transition-all";
                tabRent.className = "px-4 py-3 text-sm font-medium border-b-2 border-transparent text-[#9dabb8] hover:text-white transition-all";
            }
            
            updateBalanceInfo();
        }

        function updateBalanceInfo() {
            const select = document.getElementById('LeaseIdSelect');
            const balanceInfo = document.getElementById('balanceInfo');
            const rentBalDisplay = document.getElementById('rentBalDisplay');
            const secBalDisplay = document.getElementById('secBalDisplay');
            const rentBalContainer = document.getElementById('rentBalContainer');
            const secBalContainer = document.getElementById('secBalContainer');
            
            const selectedOption = select.options[select.selectedIndex];
            
            if (selectedOption.value) {
                const rentBal = parseFloat(selectedOption.getAttribute('data-rent-bal')) || 0;
                const secBal = parseFloat(selectedOption.getAttribute('data-sec-bal')) || 0;
                
                rentBalDisplay.textContent = 'PKR ' + rentBal.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                secBalDisplay.textContent = 'PKR ' + secBal.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                
                if (currentTab === 'Rent') {
                    rentBalContainer.classList.remove('hidden');
                    secBalContainer.classList.add('hidden');
                } else {
                    secBalContainer.classList.remove('hidden');
                    rentBalContainer.classList.add('hidden');
                }
                
                balanceInfo.classList.remove('hidden');
            } else {
                balanceInfo.classList.add('hidden');
            }
        }
    </script>
}
