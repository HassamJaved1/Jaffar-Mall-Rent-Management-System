@model IEnumerable<Jaffar_Mall_Rent_Management_System.Models.ViewModels.RentStatusViewModel>

@{
    ViewData["Title"] = "Rent Status";
}

<!-- Top Header -->
<header class="h-16 flex items-center justify-between px-6 border-b border-[#293038] bg-background-dark shrink-0 z-20">
    <div class="flex items-center gap-4">
        <h2 class="text-lg font-bold text-white">Rent Status</h2>
    </div>
    <div class="flex items-center gap-3 flex-1 justify-end">
        <!-- Search Input -->
        <div class="relative max-w-[200px] sm:max-w-xs w-full">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#9dabb8] text-[20px]">search</span>
            <input type="text" id="searchInput" placeholder="Search..." value="@ViewBag.CurrentSearch" 
                   class="w-full h-9 pl-10 pr-10 rounded-lg bg-[#293038] border border-transparent focus:border-primary/50 text-white text-sm outline-none transition-all"
                   onkeypress="if(event.key === 'Enter') applyFilters()">
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
            {
                <button onclick="document.getElementById('searchInput').value=''; applyFilters()" class="absolute right-2 top-1/2 -translate-y-1/2 text-[#9dabb8] hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            }
        </div>

        <div class="relative">
            <select id="filterStatus" onchange="applyFilters()" class="appearance-none flex h-9 items-center justify-center gap-x-2 rounded-lg bg-[#293038] px-4 pr-10 hover:bg-[#3e4854] transition-colors border border-transparent dark:border-[#3e4854] text-white text-sm font-medium outline-none">
                <option value="">Status: All</option>
                <option value="Paid" selected="@(ViewBag.CurrentStatus == "Paid" ? "selected" : null)">Status: Paid</option>
                <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending" ? "selected" : null)">Status: Pending</option>
                <option value="Overdue" selected="@(ViewBag.CurrentStatus == "Overdue" ? "selected" : null)">Status: Overdue</option>
            </select>
            <span class="material-symbols-outlined text-white text-[20px] pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">keyboard_arrow_down</span>
        </div>

        <a asp-controller="Rent" asp-action="Add" class="flex items-center gap-2 bg-primary hover:bg-primary/90 text-white text-sm font-semibold py-2 px-4 rounded-lg transition-colors shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-[20px]">add</span>
            <span class="hidden sm:inline">Add Payment</span>
        </a>
    </div>
</header>

<!-- Scrollable Content Area -->
<div class="flex-1 overflow-y-auto p-6 scroll-smooth">
    <div class="max-w-7xl mx-auto space-y-6 pb-10">
        
        <!-- Rent Status Table -->
        <div class="bg-[#1e252b] rounded-xl border border-[#293038] overflow-hidden">
            <div class="p-6 border-b border-[#293038] flex items-center justify-between">
                <h3 class="text-white text-base font-bold">Payment Details</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#293038]/50 text-[#9dabb8] text-xs uppercase tracking-wider">
                            <th class="px-6 py-3 font-semibold">Tenant</th>
                            <th class="px-6 py-3 font-semibold">Property</th>
                            <th class="px-6 py-3 font-semibold text-right">Start Date</th>
                            <th class="px-6 py-3 font-semibold text-right">End Date</th>
                            <th class="px-6 py-3 font-semibold text-right">Next Due</th>
                          @*   <th class="px-6 py-3 font-semibold text-right">Security deposit</th> *@
                            <th class="px-6 py-3 font-semibold text-right">Paid Security</th>
                           @*  <th class="px-6 py-3 font-semibold text-right">Security Bal</th> *@
                            <th class="px-6 py-3 font-semibold text-right">Monthly Rent</th>
                            <th class="px-6 py-3 font-semibold text-right">Expected Rent</th>
                            <th class="px-6 py-3 font-semibold text-right" title="Paid towards current interval">Paid (Current)</th>
                            <th class="px-6 py-3 font-semibold text-right" title="Cumulative rent paid all time">Total Rent Collected</th>
                            <th class="px-6 py-3 font-semibold text-right">Pending Rent</th>
                            <th class="px-6 py-3 font-semibold text-center">Status</th>
                            <th class="px-6 py-3 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#293038]">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="hover:bg-[#293038]/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <p class="text-white text-sm font-medium">@item.TenantName</p>
                                    </td>
                                    <td class="px-6 py-4">
                                        <p class="text-white text-sm font-medium">@item.PropertyName</p>
                                        <p class="text-[#9dabb8] text-xs">@item.PropertyNumber</p>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">@item.LeaseStartDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">@(item.LeaseEndDate?.ToString("MMM dd, yyyy") ?? "-")</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">
                                            @(
                                                item.NextRentDueDate.HasValue
                                                ? $"{item.NextRentDueDate.Value.ToString("MMM dd, yyyy")} " +
                                                  $"({(item.NextRentDueDate.Value.Date - DateTime.Now.Date).Days switch
                                                  {
                                                      < 0 => $"{Math.Abs((item.NextRentDueDate.Value.Date - DateTime.Now.Date).Days)} days overdue",
                                                      0 => "Due today",
                                                      _ => $"{(item.NextRentDueDate.Value.Date - DateTime.Now.Date).Days} days left"
                                                  }})"
                                                : "N/A"
                                            )
                                        </span>
                                    </td>
                                   @*  <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">@(item.SecurityDeposit.HasValue ? item.SecurityDeposit.Value.ToString("C") : "0.00")</span>
                                    </td> *@
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">@item.PaidSecurityDeposit.ToString("C")</span>
                                    </td>
                                   @*  <td class="px-6 py-4 text-right">
                                        <span class="text-yellow-500 text-sm font-bold">@item.SecurityBalance.ToString("C")</span>
                                    </td> *@
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm">@item.MonthlyRent.ToString("C")</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex flex-col items-end">
                                            <span class="text-white text-sm font-bold">@item.IntervalRent.ToString("N0")</span>
                                            <span class="text-[10px] text-gray-500 uppercase">Per @item.RentDueMonths Mo.</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-green-400 text-sm">@item.CurrentPaidRent.ToString("C")</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="text-white text-sm font-bold text-opacity-80">@item.TotalAmountPaid.ToString("C")</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        @if(item.Balance > 0)
                                        {
                                            <span class="text-red-500 text-sm font-bold">@item.Balance.ToString("C")</span>
                                        }
                                        else if(item.Balance < 0)
                                        {
                                            <span class="text-green-500 text-sm font-medium">@item.Balance.ToString("C") (Overpaid)</span>
                                        }
                                        else
                                        {
                                            <span class="text-[#9dabb8] text-sm">0.00</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (item.Status == "Paid")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/10 text-green-500">Paid</span>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-500/10 text-orange-500">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/10 text-blue-500">@item.Status</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                                        <a asp-action="Add" asp-route-leaseId="@item.LeaseId" class="text-primary hover:text-white transition-colors text-sm font-medium">Pay</a>
                                        <span class="text-[#293038]">|</span>
                                        <a asp-action="History" asp-route-leaseId="@item.LeaseId" class="text-[#9dabb8] hover:text-white transition-colors text-sm font-medium" title="View History">
                                            <span class="material-symbols-outlined text-[18px] align-middle">history</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="px-6 py-8 text-center text-[#9dabb8]">No active leases found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applyFilters() {
            const status = document.getElementById('filterStatus').value;
            const search = document.getElementById('searchInput').value;
            
            let url = window.location.pathname + '?';
            if (status) url += 'status=' + encodeURIComponent(status) + '&';
            if (search) url += 'search=' + encodeURIComponent(search);
            
            window.location.href = url;
        }
    </script>
}
